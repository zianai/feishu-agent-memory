# Agent 记忆系统 · 运行时配置（脚本唯一配置源）
# 语义：全部为「默认值」（:=），外部环境变量已设置时不覆盖，便于临时切换身份/参数。
# 复用到其他 Base：优先复制 config.env.local.example 为 config.env.local（不入库）填真实值。
# 表ID可用 tblxxx 或表名。

: "${MEM_BASE_TOKEN:=}"
: "${MEM_TBL_USER:=}"                          # 用户画像
: "${MEM_TBL_AGENT:=}"                         # Agent 经验
: "${MEM_TBL_SESSION:=}"                       # 会话状态

# 私有配置不入库：存在则覆盖上方默认值（须在 export 之前）
if [ -f "${MEM_LIB_DIR:-.}/config.env.local" ]; then
  # shellcheck source=/dev/null
  . "${MEM_LIB_DIR:-.}/config.env.local"
fi

: "${MEM_AGENT_ID:=main}"                      # 默认 Agent ID
: "${MEM_IM_IDENTITY:=bot}"                    # 会话消息读取身份：bot|user

: "${MEM_SHORT_TERM_MSGS:=20}"                 # 短期窗口条数
: "${MEM_BACKLOG_MSGS:=50}"                    # 首次沉淀最多回溯条数
: "${MEM_CAND_TOP_K:=30}"                      # 粗筛候选上限
: "${MEM_REFINE_FALLBACK_K:=10}"               # 精排失败时的降级条数
: "${MEM_CLIP_CHARS:=1000}"                    # 单条记忆截断
: "${MEM_USER_BUDGET_CHARS:=2400}"             # 用户画像注入预算（字符）
: "${MEM_AGENT_BUDGET_CHARS:=1600}"            # Agent 经验注入预算（字符）
: "${MEM_SUMMARY_MAX_CHARS:=800}"              # 滚动摘要上限

: "${MEM_IDLE_MINUTES:=30}"                    # 静默多少分钟视为会话结束
: "${MEM_PENDING_THRESHOLD:=20}"               # 未沉淀条数阈值（触发器B）
: "${MEM_CONFIRM_THRESHOLD:=0.6}"              # 置信度低于此值的记忆进入「待确认」观测

export MEM_BASE_TOKEN MEM_TBL_USER MEM_TBL_AGENT MEM_TBL_SESSION
export MEM_AGENT_ID MEM_IM_IDENTITY MEM_SHORT_TERM_MSGS MEM_BACKLOG_MSGS
export MEM_CAND_TOP_K MEM_REFINE_FALLBACK_K MEM_CLIP_CHARS
export MEM_USER_BUDGET_CHARS MEM_AGENT_BUDGET_CHARS MEM_SUMMARY_MAX_CHARS
export MEM_IDLE_MINUTES MEM_PENDING_THRESHOLD MEM_CONFIRM_THRESHOLD

# 无人值守沉淀的 LLM 命令（读 stdin prompt、stdout 出文本）。
# agent 在场时可留空，由 agent 充当模型。
: "${LLM_CMD:=}"
export LLM_CMD
# 示例：export LLM_CMD="bash \"\$MEM_SKILL_DIR/scripts/llm.sh\""
